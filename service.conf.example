# enable debug logging
YUBIKEY_TOUCH_DETECTOR_VERBOSE=false

# show desktop notifications
YUBIKEY_TOUCH_DETECTOR_NOTIFY=true

# customize desktop notifications
# YUBIKEY_TOUCH_DETECTOR_NOTIFY_TITLE="Security key required"
# YUBIKEY_TOUCH_DETECTOR_NOTIFY_BODY="Touch your YubiKey to continue ({{.Reasons}}).{{with .Details}}\n{{.}}{{end}}"
# YUBIKEY_TOUCH_DETECTOR_NOTIFY_URGENCY="critical"

# show a dialog window while a touch is required (Linux only)
# YUBIKEY_TOUCH_DETECTOR_POPUP=true

# where to show the dialog: center (default), top, bottom, left, right,
# top-left, top-right, bottom-left, bottom-right, or auto
# YUBIKEY_TOUCH_DETECTOR_POPUP_POSITION=top-right

# describe the request that waits for a touch, one template per kind
# YUBIKEY_TOUCH_DETECTOR_SSH_DETAILS="SSH to {{.Target}} [{{.Address}}] {{.FromApp}}"
# YUBIKEY_TOUCH_DETECTOR_ANSIBLE_DETAILS="Ansible to:
# {{.Hosts}}"
# YUBIKEY_TOUCH_DETECTOR_APP_DETAILS="requested by {{.Requester}}"

# do not print notifications to stdout
YUBIKEY_TOUCH_DETECTOR_STDOUT=false

# disable Un*x socket notifier
YUBIKEY_TOUCH_DETECTOR_NOSOCKET=false
